<?xml version="1.0" encoding="utf-8"?>
<!-- The hearth widget: a looping close-up of the hero (frames rendered by the app), and three omens. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ViewFlipper
                android:id="@+id/w_flip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="110" />

            <TextView
                android:id="@+id/w_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/jersey15"
                android:gravity="center"
                android:padding="12dp"
                android:text="Open Grindstone to kindle the hearth."
                android:textColor="#FF9B907C"
                android:textSize="15.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/scrim_top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:paddingEnd="10dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/w_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/jersey15"
                    android:letterSpacing="0.06"
                    android:shadowColor="#FF000000"
                    android:shadowRadius="4"
                    android:singleLine="true"
                    android:text="ASHION · LV 3"
                    android:textColor="#FFC8B27A"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/w_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jersey15"
                    android:letterSpacing="0.06"
                    android:shadowColor="#FF000000"
                    android:shadowRadius="4"
                    android:text="THRIVING"
                    android:textColor="#FFC8B27A"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/w_xp"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="bottom"
                android:max="100"
                android:progress="40"
                android:progressDrawable="@drawable/xp_bar" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/w_chips"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:padding="5dp">

            <LinearLayout
                android:id="@+id/w_c1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                
                android:background="@drawable/chip_bg"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="7dp"
                android:paddingEnd="5dp">

                <TextView
                    android:id="@+id/w_c1_l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/jersey15"
                    android:singleLine="true"
                    android:textColor="#FF9B907C"
                    android:textSize="13.5sp"
                    android:text="Lawn" />

                <TextView
                    android:id="@+id/w_c1_v"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/jersey15"
                    android:singleLine="true"
                    android:textColor="#FFE9D7A6"
                    android:textSize="16.5sp"
                    android:text="—" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_c2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/chip_bg"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="7dp"
                android:paddingEnd="5dp">

                <TextView
                    android:id="@+id/w_c2_l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/jersey15"
                    android:singleLine="true"
                    android:textColor="#FF9B907C"
                    android:textSize="13.5sp"
                    android:text="Lawn" />

                <TextView
                    android:id="@+id/w_c2_v"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/jersey15"
                    android:singleLine="true"
                    android:textColor="#FFE9D7A6"
                    android:textSize="16.5sp"
                    android:text="—" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_c3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/chip_bg"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="7dp"
                android:paddingEnd="5dp">

                <TextView
                    android:id="@+id/w_c3_l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/jersey15"
                    android:singleLine="true"
                    android:textColor="#FF9B907C"
                    android:textSize="13.5sp"
                    android:text="Lawn" />

                <TextView
                    android:id="@+id/w_c3_v"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/jersey15"
                    android:singleLine="true"
                    android:textColor="#FFE9D7A6"
                    android:textSize="16.5sp"
                    android:text="—" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
